{
  models: {
    mode: "merge",
    providers: {
      bailian: {
        baseUrl: "https://dashscope.aliyuncs.com/apps/anthropic",
        apiKey: { source: "env", provider: "default", id: "DASHSCOPE_API_KEY" },
        api: "anthropic-messages",
        models: [
          {
            id: "${SIDE_AUDIO_BOT_OPENCLAW_MODEL_ID}",
            name: "${SIDE_AUDIO_BOT_OPENCLAW_MODEL_ID}",
            reasoning: false,
            input: ["text"],
            contextWindow: 128000,
            maxTokens: 8192,
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            compat: { thinkingFormat: "openai" },
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      skipBootstrap: true,
      model: { primary: "${SIDE_AUDIO_BOT_OPENCLAW_MODEL}" },
      models: { "${SIDE_AUDIO_BOT_OPENCLAW_MODEL}": {} },
    },
    list: [
      {
        id: "side-audio-bot-backend",
        default: true,
        name: "side-audio-bot Backend Agent",
        workspace: "${SIDE_AUDIO_BOT_OPENCLAW_WORKSPACE}",
      },
    ],
  },
  tools: {
    sessions: { visibility: "all" },
  },
  gateway: {
    mode: "local",
    bind: "loopback",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
  },
}
