MEMCODE_API_URL=https://memory.memcode.in
# Create this key with "Side Audio Bot" selected in the Memcode dashboard.
MEMCODE_API_KEY=your_memcode_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key

# Keep the example isolated from the regular Gateway configuration.
AGENT_PROTOCOL=none
SIDEAUDIO_CONFIG_DIR=.side-audio/runtime

# The personal Memcode credential is deliberately bound to exactly one Gateway
# owner. Leave this value at its default for a local personal Gateway.
SIDE_AUDIO_BOT_PERSONAL_OWNER_ID=user_personal
PORT=3102
